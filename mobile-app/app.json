{
  "expo": {
    "name": "PropEdge AI Agent",
    "slug": "propedge-agent",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#07080f"
    },
    "android": {
      "permissions": [
        "android.permission.CALL_PHONE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_PHONE_STATE",
        "android.permission.INTERNET"
      ],
      "package": "com.propedge.agent"
    },
    "ios": {
      "bundleIdentifier": "com.propedge.agent",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Priya needs the mic to listen to leads during calls",
        "NSSpeechRecognitionUsageDescription": "Priya needs speech recognition to understand leads"
      }
    },
    "plugins": [
      "@react-native-voice/voice"
    ],
    "sdkVersion": "51.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "cccb65dc-47cd-4cbf-98e8-d7ee2d0c0d09"
      }
    }
  }
}
