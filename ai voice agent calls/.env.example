# ============================================================
# PropEdge AI Voice Bridge — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── AI SERVICES ──────────────────────────────────────────────
# OpenAI — AI conversation brain
OPENAI_API_KEY=sk-your-openai-key-here

# Deepgram — Speech to Text + Text to Speech
DEEPGRAM_API_KEY=your-deepgram-key-here

# Deepgram voice model (natural sounding)
# Options: aura-asteria-en | aura-luna-en | aura-stella-en | aura-athena-en
VOICE_MODEL=aura-asteria-en

# ── PROPEDGE BACKEND ─────────────────────────────────────────
# Your deployed Vercel backend URL
PROPEDGE_BACKEND_URL=https://your-project.vercel.app

# ── AGENT INFO ────────────────────────────────────────────────
AGENT_EMAIL=your@email.com
COMPANY_NAME=Dream Homes Realty

# ── CALL TRANSFER ─────────────────────────────────────────────
# Phone number to WhatsApp-notify when lead asks for human agent
TRANSFER_NUMBER=+919876543210

# ── SERVER ────────────────────────────────────────────────────
PORT=3000
