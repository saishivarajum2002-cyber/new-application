# ============================================================
# ENVIRONMENT VARIABLES — Copy this to .env and fill in
# ============================================================

# ── DATABASE ─────────────────────────────────────────────
# MongoDB Atlas connection string
# Get free at: mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/propedge

# ── GEMINI AI (REQUIRED for voice agent) ─────────────────
# Get free at: aistudio.google.com → Get API Key
GEMINI_API_KEY=paste_your_gemini_api_key_here

# ── EMAIL (RESEND) ────────────────────────────────────────
# Get free at: resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── WHATSAPP ──────────────────────────────────────────────

# ── SUPABASE (Optional) ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key

# ── AGENT INFO ────────────────────────────────────────────
AGENT_EMAIL=your@email.com
AGENT_NAME=Priya

# ── SECURITY ──────────────────────────────────────────────
API_SECRET=choose_a_random_secret_string

# ── WHATSAPP BRIDGE (Your own phone — no Meta API needed) ────────────
# Run whatsapp-bridge/start.sh in Termux, then set this to your phone IP
# Use ngrok for remote access: ngrok http 3001
WA_BRIDGE_URL=http://YOUR_PHONE_IP:3001
